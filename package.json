{
    "name": "anas",
    "version": "3.0.3",
    "productName": "Anas",
    "description": "Anas, short for Ananas: a local desktop agent with project-scoped context, tools, and skills customization.",
    "main": "out/main/index.js",
    "scripts": {
        "ensure:electron": "node scripts/ensure-electron.cjs",
        "postinstall": "patch-package --error-on-fail && npm run ensure:electron && node scripts/prepare-native-dependencies.cjs",
        "dev": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-vite dev",
        "clean:build": "node scripts/clean-build-output.cjs build",
        "clean:pack": "node scripts/clean-build-output.cjs pack",
        "clean:portable": "node scripts/clean-build-output.cjs portable",
        "build": "npm run clean:build && npm run typecheck && electron-vite build && npm run verify:main-bundle",
        "preview": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-vite preview",
        "pack": "npm run build && npm run clean:pack && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --dir && npm run verify:packaged:normal",
        "dist": "npm run pack",
        "pack:mac:release": "node electron-builder.mac-release.cjs && npm run build && node scripts/clean-build-output.cjs mac-release && electron-builder --mac --config electron-builder.mac-release.cjs --publish never && node scripts/verify-packaged-app.cjs verify release-macos",
        "pack:win:release": "npm run build && npm run clean:pack && electron-builder --win --x64 --dir --publish never && npm run verify:packaged:normal && node scripts/archive-windows-release.cjs",
        "portable": "npm run build && npm run clean:portable && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --config electron-builder.portable.yml && npm run verify:packaged:portable",
        "verify:dependencies": "node scripts/verify-dependencies.cjs",
        "verify:audit": "npm audit --omit=dev --audit-level=high",
        "verify:reproducible-build": "node scripts/verify-reproducible-build.cjs",
        "verify:release-packages": "npm run verify:dependencies && npm run verify:reproducible-build && npm run pack && npm run portable && node scripts/verify-packaged-app.cjs compare release-build/win-unpacked release-portable/win-unpacked",
        "ci:release": "node scripts/run-release-ci.cjs",
        "lint": "eslint . --max-warnings 0",
        "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
        "test:coverage": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --coverage",
        "test:dom": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --config vitest.dom.config.ts",
        "test:e2e": "npm run build && node scripts/run-electron-e2e.cjs",
        "test:e2e:pty": "npm run build && node scripts/run-electron-e2e.cjs --pty-only",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "verify:main-bundle": "node scripts/verify-main-bundle.cjs",
        "verify:packaged:normal": "node scripts/verify-packaged-app.cjs verify release-build",
        "verify:packaged:portable": "node scripts/verify-packaged-app.cjs verify release-portable/win-unpacked",
        "eval:coding": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --config vitest.evaluation.config.ts",
        "eval:coding:live": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --config vitest.evaluation.live.config.ts"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/higale/Anas-public.git"
    },
    "homepage": "https://github.com/higale/Anas-public#readme",
    "bugs": {
        "url": "https://github.com/higale/Anas-public/issues"
    },
    "keywords": [],
    "author": "gale",
    "license": "MIT",
    "type": "commonjs",
    "dependencies": {
        "@cfworker/json-schema": "4.1.1",
        "@langchain/anthropic": "1.5.10",
        "@langchain/core": "^1.2.9",
        "@langchain/langgraph": "^1.4.12",
        "@langchain/langgraph-checkpoint": "1.1.5",
        "@langchain/mcp-adapters": "^1.1.4",
        "@langchain/openai": "^1.5.9",
        "@noble/hashes": "2.3.0",
        "@radix-ui/react-alert-dialog": "^1.1.16",
        "@radix-ui/react-context-menu": "^2.3.7",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dismissable-layer": "^1.1.19",
        "@radix-ui/react-dropdown-menu": "^2.1.18",
        "@radix-ui/react-popover": "^1.1.17",
        "@radix-ui/react-tabs": "^1.1.21",
        "@vscode/ripgrep": "1.18.0",
        "ajv": "8.20.0",
        "better-sqlite3": "^12.11.1",
        "deepagents": "1.13.0",
        "diff": "^9.0.0",
        "electron-log": "^5.4.4",
        "exifr": "7.1.3",
        "fast-json-stable-stringify": "2.1.0",
        "i18next": "^26.4.0",
        "image-dimensions": "^2.5.1",
        "koffi": "3.1.6",
        "langchain": "1.5.11",
        "lucide-react": "^1.33.0",
        "mammoth": "^1.12.0",
        "mediainfo.js": "0.3.8",
        "node-pty": "1.2.0-beta.15",
        "p-queue": "9.3.3",
        "pdf-parse": "^2.4.5",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-easy-crop": "^6.2.3",
        "react-i18next": "^17.0.12",
        "react-markdown": "^10.1.0",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "shell-quote": "1.10.0",
        "sonner": "^2.0.7",
        "stubborn-fs": "^2.0.0",
        "ws": "^8.21.3",
        "yaml": "^2.9.0",
        "yauzl": "^3.4.0",
        "yazl": "^3.3.1",
        "yet-another-react-lightbox": "^3.32.0"
    },
    "devDependencies": {
        "@electron/rebuild": "4.2.0",
        "@eslint/js": "^9.39.5",
        "@swc/core": "^1.16.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.5",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^25.9.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/ws": "^8.18.1",
        "@types/yauzl": "^3.4.0",
        "@types/yazl": "^3.3.1",
        "@vitejs/plugin-react": "^5.1.4",
        "@vitest/coverage-v8": "^4.1.11",
        "axe-core": "^4.13.0",
        "cross-env": "^10.1.0",
        "electron": "^42.9.3",
        "electron-builder": "^26.15.2",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.11.0",
        "jsdom": "^29.1.1",
        "monaco-editor": "^0.56.0",
        "patch-package": "8.0.1",
        "playwright": "^1.62.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^7.3.5",
        "vitest": "^4.1.11"
    }
}
